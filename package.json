{
  "name": "pomodoso",
  "private": true,
  "packageManager": "pnpm@9.14.2",
  "scripts": {
    "dev:extension": "pnpm --filter extension dev",
    "extension": "pnpm --filter extension dev",
    "build:extension": "pnpm --filter extension build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint"
  },
  "devDependencies": {
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"],
    "packageExtensions": {
      "react-router-dom@*": {
        "dependencies": { "@types/react": "18.3.29" }
      },
      "react-router@*": {
        "dependencies": { "@types/react": "18.3.29" }
      },
      "vite-react-ssg@*": {
        "dependencies": { "@types/react": "18.3.29" }
      },
      "react-helmet-async@*": {
        "dependencies": { "@types/react": "18.3.29" }
      }
    }
  }
}
