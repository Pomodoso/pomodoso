# Copy to .env.local and fill in the values — see extension/.env.production
# or web/.env.local for the values already in use (same Supabase project,
# same backend). Expo only exposes vars prefixed EXPO_PUBLIC_ to client code.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_API_URL=https://api.pomodoso.com
# iOS OAuth client (application type "iOS", bundle id com.pomodoso.app) from
# the same Google Cloud project as extension/.env's Desktop client. No
# secret — iOS-type Google OAuth clients are PKCE-only, nothing to keep
# private here (same reasoning as the Desktop client's, see calendarSync.ts).
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com

# In-app purchases need no key. StoreKit talks to the App Store using the
# app's own signature, and the products come from App Store Connect under the
# same bundle ID. See modules/pomodoso-iap.
