{
  "expo": {
    "name": "Pomodoso",
    "slug": "pomodoso",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": [
      "pomodoso",
      "com.googleusercontent.apps.997845471451-gquehumm6i8mb8cpg95m36f57gf4v643"
    ],
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pomodoso.app",
      "appleTeamId": "35392GG43S",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.pomodoso.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "./plugins/withoutPushEntitlement",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FBFAF7"
        }
      ],
      "expo-sqlite",
      "expo-audio",
      "expo-sharing",
      "expo-secure-store",
      "expo-background-task",
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "PomodoroActivity",
              "displayName": "Pomodoro Timer",
              "description": "Shows the running focus session or break on the Lock Screen and Dynamic Island.",
              "supportedFamilies": [
                "accessoryCircular",
                "accessoryRectangular"
              ]
            }
          ]
        }
      ],
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
