DATABASE_URL=postgres://postgres:postgres@localhost:5432/pomodoso
PORT=8080
FRONTEND_URL=http://localhost:5173

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_ANNUAL_PRICE_ID=price_...
STRIPE_PRO_MONTHLY_PRICE_ID=price_...
STRIPE_FOUNDER_LIFETIME_PRICE_ID=price_...

# RevenueCat (App Store / Play Store purchases) — the shared secret is whatever
# you put in the webhook's Authorization header field in the RevenueCat
# dashboard (Project settings → Integrations → Webhooks). Sent verbatim, so make
# it long and random. Leave blank to reject all store purchases.
REVENUECAT_WEBHOOK_SECRET=

# Postmark — the Server API token, not the account token. Server API Tokens tab
# of the server you want these sent from. Leave blank to disable email entirely.
POSTMARK_SERVER_TOKEN=
# Sender must be a verified Sender Signature, or on a domain with DKIM set up
# under Postmark's Sender Signatures. An unverified sender fails with 422 on
# every send. Leave blank and nothing is sent — deliberately no fallback: mail
# used to go out from another product's domain, which is worse than silence.
# hello@, not noreply@: the address forwards to a real inbox, so replies do
# arrive — and a sender that receives mail is worth more for domain reputation
# than one that never does. support@ stays as the contact in the footer.
POSTMARK_FROM_EMAIL=Pomodoso <hello@pomodoso.com>

# Sentry (error reporting) — leave blank to disable. From your Sentry project:
# Settings → Client Keys (DSN).
SENTRY_DSN=
# Fraction of transactions traced (0.0–1.0). Defaults to 0.2 (20%).
SENTRY_TRACES_SAMPLE_RATE=0.2
