{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT hl.habit_id, hl.date, hl.value\n        FROM habit_log hl\n        JOIN habit h ON h.id = hl.habit_id\n        WHERE h.user_id = $1 AND h.deleted_at IS NULL\n          AND hl.date > $2 AND hl.date <= $3\n        ",
